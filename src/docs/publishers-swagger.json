{
  "openapi": "3.0.0",
  "info": {
    "title": "Bookstore: Publishers Documentation",
    "version": "1.0.0",
    "description": "This is a sample API",
    "contact": {
      "name": "API Support",
      "email": "support@bookstore.com"
    }
  },
  "paths": {
    "/api/v1/publishers": {
      "post": {
        "tags": ["Publishers"],
        "summary": "Create a new publisher",
        "description": "This endpoint allows you to create a new publisher.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Jhon Doe" },
                  "address": { "type": "string", "example": "123 Main St, Anytown, USA" },
                  "phone": { "type": "string", "example": "12988552266" },
                  "website": { "type": "string", "example": "https://www.example.com" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Publisher created successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Publisher created successfully",
                  "data": {
                    "id": "123",
                    "name": "Jhon Doe",
                    "address": "123 Main St, Anytown, USA",
                    "phone": "12988552266",
                    "website": "https://www.example.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Invalid request"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Publishers"],
        "summary": "Get all publishers",
        "description": "This endpoint allows you to retrieve all publishers with pagination support. If pagination parameters are not provided, default values will be used (page=1, limit=10, sortBy=id, sortOrder=ASC).",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (must be greater than 0)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page (must be between 1 and 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "example": 10
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Field to sort by",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id",
              "example": "name"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Sort order (ASC for ascending, DESC for descending)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["ASC", "DESC"],
              "default": "ASC",
              "example": "ASC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publishers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "example": "156055d7-021e-4d25-8698-7b21fb9783dc"
                          },
                          "name": {
                            "type": "string",
                            "example": "Abril"
                          },
                          "address": {
                            "type": "string",
                            "example": "Av Barbacena, n2"
                          },
                          "phone": {
                            "type": "string",
                            "example": "12988552233"
                          },
                          "website": {
                            "type": "string",
                            "example": "www.abrileditora.com.br"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2025-09-13T16:47:13.629Z"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2025-09-13T16:47:13.629Z"
                          }
                        },
                        "required": ["id", "name", "address", "phone", "website", "createdAt", "updatedAt"]
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "currentPage": {
                          "type": "integer",
                          "example": 1
                        },
                        "totalPages": {
                          "type": "integer",
                          "example": 1
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 1
                        },
                        "itemsPerPage": {
                          "type": "integer",
                          "example": 10
                        },
                        "hasNext": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasPrevious": {
                          "type": "boolean",
                          "example": false
                        }
                      },
                      "required": ["currentPage", "totalPages", "totalItems", "itemsPerPage", "hasNext", "hasPrevious"]
                    },
                    "message": {
                      "type": "string",
                      "example": "Publishers retrieved successfully"
                    }
                  },
                  "required": ["success", "data", "pagination", "message"]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid pagination parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "examples": {
                        "invalidPage": {
                          "value": "Page must be greater than 0"
                        },
                        "invalidLimit": {
                          "value": "Limit must be between 1 and 100"
                        }
                      }
                    }
                  },
                  "required": ["success", "error"]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Error retrieving publishers"
                    }
                  },
                  "required": ["success", "message"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/publishers/{id}": {
      "get": {
        "tags": ["Publishers"],
        "summary": "Get publisher by ID",
        "description": "This endpoint allows you to retrieve a specific publisher by its unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the publisher",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "156055d7-021e-4d25-8698-7b21fb9783dc"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Unique identifier of the publisher."
                        },
                        "name": {
                          "type": "string",
                          "description": "The full name of the publisher."
                        },
                        "address": {
                          "type": "string",
                          "description": "The address of the publisher."
                        },
                        "phone": {
                          "type": "string",
                          "description": "The publisher's phone number."
                        },
                        "website": {
                          "type": "string",
                          "description": "The website of the publisher."
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "The date and time the publisher record was created."
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "The date and time the publisher record was last updated."
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "description": "A message describing the result of the request."
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "156055d7-021e-4d25-8698-7b21fb9783dc",
                    "name": "Abril",
                    "address": "Av Barbacena, n2",
                    "phone": "12988552233",
                    "website": "www.abrileditora.com.br",
                    "createdAt": "2025-09-13T16:47:13.629Z",
                    "updatedAt": "2025-09-13T16:47:13.629Z"
                  },
                  "message": "Publisher retrieved successfully"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Publisher ID is required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful."
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message describing what went wrong."
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Publisher id is required"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Publisher not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful."
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message describing what went wrong."
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Publisher not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates if the request was successful."
                    },
                    "error": {
                      "type": "string",
                      "description": "Error message describing what went wrong."
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Publishers"],
        "summary": "Update a publisher",
        "description": "Updates an existing publisher with the provided data. At least one field must be provided for update.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Publisher ID (UUID format)",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "12f46a7a-a95f-4f3d-9036-8407fffa253e"
            }
          }
        ],
        "requestBody": {
          "description": "Publisher data to update",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Publisher name",
                    "minLength": 2,
                    "maxLength": 255,
                    "example": "Etica Nova"
                  },
                  "address": {
                    "type": "string",
                    "description": "Publisher address",
                    "maxLength": 500,
                    "example": "Av Domingos, n720"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Publisher phone number (7-15 digits)",
                    "pattern": "^\\d{7,15}$",
                    "example": "12988226633"
                  },
                  "website": {
                    "type": "string",
                    "description": "Publisher website URL",
                    "format": "uri",
                    "pattern": "^https?://",
                    "example": "www.editoraetica.com.br"
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              "examples": {
                "updateName": {
                  "summary": "Update only name",
                  "value": {
                    "name": "Etica Nova"
                  }
                },
                "updateMultiple": {
                  "summary": "Update multiple fields",
                  "value": {
                    "name": "Etica Nova",
                    "address": "Av Domingos, n720",
                    "phone": "12988226633",
                    "website": "www.editoraetica.com.br"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publisher updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Publisher unique identifier",
                          "example": "12f46a7a-a95f-4f3d-9036-8407fffa253e"
                        },
                        "name": {
                          "type": "string",
                          "description": "Publisher name",
                          "example": "Etica Nova"
                        },
                        "address": {
                          "type": "string",
                          "description": "Publisher address",
                          "example": "Av Domingos, n720"
                        },
                        "phone": {
                          "type": "string",
                          "description": "Publisher phone number",
                          "example": "12988226633"
                        },
                        "website": {
                          "type": "string",
                          "description": "Publisher website URL",
                          "example": "www.editoraetica.com.br"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Publisher creation timestamp",
                          "example": "2025-09-14T20:42:36.469Z"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Publisher last update timestamp",
                          "example": "2025-09-15T23:24:19.168Z"
                        }
                      },
                      "required": ["id", "name", "address", "phone", "website", "createdAt", "updatedAt"]
                    },
                    "message": {
                      "type": "string",
                      "example": "Publisher updated successfully"
                    }
                  },
                  "required": ["success", "data", "message"]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["success", "error"]
                },
                "examples": {
                  "missingId": {
                    "summary": "Missing publisher ID",
                    "value": {
                      "success": false,
                      "error": "Publisher ID is required"
                    }
                  },
                  "noFields": {
                    "summary": "No fields to update",
                    "value": {
                      "success": false,
                      "error": "No fields to update"
                    }
                  },
                  "invalidName": {
                    "summary": "Invalid name length",
                    "value": {
                      "success": false,
                      "error": "Name must be between 2 and 255 characters"
                    }
                  },
                  "invalidAddress": {
                    "summary": "Invalid address length",
                    "value": {
                      "success": false,
                      "error": "Address must be at most 500 characters"
                    }
                  },
                  "invalidPhone": {
                    "summary": "Invalid phone format",
                    "value": {
                      "success": false,
                      "error": "Phone must be a valid number with 7 to 15 digits"
                    }
                  },
                  "invalidWebsite": {
                    "summary": "Invalid website URL",
                    "value": {
                      "success": false,
                      "error": "Website must be a valid URL"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Publisher not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Publisher not found"
                    }
                  },
                  "required": ["success", "message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  },
                  "required": ["success", "error"]
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a publisher",
        "description": "Deletes a specific publisher by ID from the system",
        "tags": ["Publishers"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the publisher to delete",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        ],
        "responses": {
          "200": {
            "description": "Publisher deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Publisher deleted successfully"
                    }
                  },
                  "required": ["success", "message"]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input or publisher not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "enum": ["Valid Publisher ID is required", "Publisher with id {id} not found"]
                    }
                  },
                  "required": ["success", "error"]
                },
                "examples": {
                  "invalid_id": {
                    "summary": "Invalid Publisher ID",
                    "value": {
                      "success": false,
                      "error": "Valid Publisher ID is required"
                    }
                  },
                  "publisher_not_found": {
                    "summary": "Publisher Not Found",
                    "value": {
                      "success": false,
                      "error": "Publisher with id 123e4567-e89b-12d3-a456-426614174000 not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Internal Server Error"
                    }
                  },
                  "required": ["success", "error"]
                }
              }
            }
          }
        }
      }
    }
  }
}
